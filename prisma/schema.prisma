// RejoFood Prisma schema
// Foundation: User + Session + Role-based profiles (Customer/Merchant/Driver/Admin)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// All four roles share one identity (User) but each gets a dedicated profile table.
/// This keeps permissions clean and lets each role's data evolve independently.
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  phone           String?        @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean        @default(true)

  /// 2FA TOTP secret (base32). null = belum disetup. Disimpan terenkripsi di production.
  twoFactorSecret String?
  /// true jika 2FA sudah diaktifkan (secret sudah diverifikasi). Wajib true untuk ADMIN.
  twoFactorEnabled Boolean       @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer        Customer?
  merchant        Merchant?
  driver          Driver?
  admin           Admin?
  sessions        Session[]
}

/// Token-based session, stored in DB so we can revoke from any device.
model Session {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  /// Timestamp aktivitas terakhir (untuk idle timeout admin). Di-touch setiap request.
  /// Null = session lama sebelum fitur ini, dianggap aktif.
  lastActivityAt  DateTime?
  createdAt       DateTime @default(now())
  ipAddress       String?
  userAgent       String?

  @@index([userId])
  @@index([lastActivityAt])
}

model Customer {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Merchant {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantName String
  description    String?
  logoUrl        String?
  /// Alamat restoran untuk display + driver pickup
  address        String?
  /// Kategori masakan: "Indonesia", "Chinese", "Western", "Vegan", dll.
  cuisine        String?
  rating         Float    @default(0)
  isOpen         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menuItems      MenuItem[]
}

/// Item menu milik merchant. Item boleh unavailable tanpa hapus (untuk stok habis sementara).
model MenuItem {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int      // dalam Rupiah, integer agar tidak floating-point error
  imageUrl    String?
  /// Kategori bebas string: "Makanan", "Minuman", "Dessert", "Snack", dll.
  category    String   @default("Lainnya")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([merchantId, isAvailable])
  @@index([category])
}

model Driver {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType      String   @default("motorcycle")
  vehiclePlate     String?
  isOnline         Boolean  @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  rating           Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[]") // JSON-encoded string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CUSTOMER
  MERCHANT
  DRIVER
  ADMIN
}

/// Jejak forensik: siapa melakukan apa, kapan, dari mana.
/// Setiap aksi sensitif (login, 2FA, role change, user ban, dll.) wajib dicatat.
/// Tabel ini append-only — tidak ada UPDATE/DELETE dari aplikasi (hanya DBA untuk retensi).
model AuditLog {
  id          String   @id @default(cuid())
  /// ID user yang melakukan aksi. null = aksi anonim (login attempt untuk email tidak dikenal).
  actorId     String?
  /// Email yang dipakai saat aksi (berguna jika actorId null, atau untuk cross-reference).
  actorEmail  String?
  /// Role user saat aksi dilakukan. null = belum terauth (pre-login).
  actorRole   Role?
  /// Kategori aksi: "auth", "admin", "merchant", "driver", "order", dll.
  category    String
  /// Nama aksi spesifik: "login.success", "login.failed", "2fa.setup", "user.ban", dll.
  action      String
  /// ID objek yang dimanipulasi (user ID, order ID, dll). null jika tidak relevan.
  targetId    String?
  /// Tipe objek target: "user", "order", "merchant", dll.
  targetType  String?
  /// Deskripsi human-readable, contoh: "Login berhasil sebagai ADMIN".
  description String
  /// Snapshot metadata tambahan dalam JSON string (IP, user-agent, before/after state, dll).
  metadata    String?
  /// Hasil aksi: "success" | "failure" | "denied".
  outcome     String   @default("success")
  /// IP pelaku.
  ipAddress   String?
  /// User-Agent pelaku (browser/device).
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([category, action])
  @@index([createdAt])
}
