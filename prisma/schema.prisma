// RejoFood Prisma schema
// Foundation: User + Session + Role-based profiles (Customer/Merchant/Driver/Admin)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // DEV (local): sqlite  →  set DATABASE_URL=file:./db/custom.db in .env
  // PROD (Vercel): postgresql  →  set DATABASE_URL=postgresql://... in Vercel env
  // ⚠️ Saat switch, update provider di bawah ini juga.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// All four roles share one identity (User) but each gets a dedicated profile table.
/// This keeps permissions clean and lets each role's data evolve independently.
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  phone           String?        @unique
  passwordHash    String
  fullName        String
  role            Role           @default(CUSTOMER)
  avatarUrl       String?
  isActive        Boolean        @default(true)

  /// 2FA TOTP secret (base32). null = belum disetup. Disimpan terenkripsi di production.
  twoFactorSecret String?
  /// true jika 2FA sudah diaktifkan (secret sudah diverifikasi). Wajib true untuk ADMIN.
  twoFactorEnabled Boolean       @default(false)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer        Customer?
  merchant        Merchant?
  driver          Driver?
  admin           Admin?
  sessions        Session[]
  wallet          Wallet?
}

/// Token-based session, stored in DB so we can revoke from any device.
model Session {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  /// Timestamp aktivitas terakhir (untuk idle timeout admin). Di-touch setiap request.
  /// Null = session lama sebelum fitur ini, dianggap aktif.
  lastActivityAt  DateTime?
  createdAt       DateTime @default(now())
  ipAddress       String?
  userAgent       String?

  @@index([userId])
  @@index([lastActivityAt])
}

model Customer {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
}

model Merchant {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantName String
  description    String?
  logoUrl        String?
  /// Alamat restoran untuk display + driver pickup
  address        String?
  /// Kategori masakan: "Indonesia", "Chinese", "Western", "Vegan", dll.
  cuisine        String?
  rating         Float    @default(0)
  isOpen         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  menuItems      MenuItem[]
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
}

/// Item menu milik merchant. Item boleh unavailable tanpa hapus (untuk stok habis sementara).
model MenuItem {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int      // dalam Rupiah, integer agar tidak floating-point error
  imageUrl    String?
  /// Kategori bebas string: "Makanan", "Minuman", "Dessert", "Snack", dll.
  category    String   @default("Lainnya")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([merchantId])
  @@index([merchantId, isAvailable])
  @@index([category])
}

model Driver {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType      String   @default("motorcycle")
  vehiclePlate     String?
  isOnline         Boolean  @default(false)
  currentLatitude  Float?
  currentLongitude Float?
  rating           Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model Admin {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String   @default("[]") // JSON-encoded string array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CUSTOMER
  MERCHANT
  DRIVER
  ADMIN
}

/// Status pembayaran
enum PaymentStatus {
  PENDING    /// Menunggu pembayaran (untuk online methods)
  SUCCESS    /// Pembayaran berhasil
  FAILED     /// Pembayaran gagal/expired
  REFUNDED   /// Pembayaran dikembalikan (saat customer cancel setelah bayar)
}

/// Metode pembayaran
enum PaymentMethod {
  COD        /// Cash on Delivery — bayar cash ke driver
  QRIS       /// QRIS (semua e-wallet + m-banking)
  VA_BCA     /// Virtual Account BCA
  VA_MANDIRI /// Virtual Account Mandiri
  VA_BNI     /// Virtual Account BNI
  EWALLET_GOPAY
  EWALLET_OVO
  EWALLET_DANA
  WALLET     /// RejoPay — dompet digital internal RejoFood
}

/// Tipe transaksi dompet (RejoPay).
enum WalletTxType {
  TOPUP        /// Customer top-up saldo (via QRIS/VA/e-wallet)
  PAYMENT      /// Customer bayar order pakai saldo
  REFUND       /// Refund ke dompet karena order dibatalkan
  EARNING      /// Driver/merchant menerima earning dari order
  WITHDRAWAL   /// Driver/merchant tarik dana ke bank
  ADJUSTMENT   /// Penyesuaian manual oleh admin (cashback, koreksi)
}

/// Status transaksi dompet.
enum WalletTxStatus {
  PENDING   /// Top-up/withdrawal menunggu konfirmasi gateway
  SUCCESS   /// Transaksi berhasil, saldo sudah ter-update
  FAILED    /// Transaksi gagal, saldo tidak berubah
}

/// Status pesanan mengikuti lifecycle:
///   PENDING → ACCEPTED → PREPARING → READY → PICKED_UP → DELIVERED
///   PENDING/ACCEPTED/PREPARING/READY → CANCELLED (oleh customer sebelum PICKED_UP atau merchant reject)
enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  PICKED_UP
  DELIVERED
  CANCELLED
}

/// Order = transaksi pesanan dari customer ke merchant, diantar oleh driver.
model Order {
  id              String      @id @default(cuid())
  /// Human-readable code: "RF-XXXXXX" (6 char alphanumeric)
  code            String      @unique
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  merchantId      String
  merchant        Merchant    @relation(fields: [merchantId], references: [id])
  driverId        String?
  driver          Driver?     @relation(fields: [driverId], references: [id])
  status          OrderStatus @default(PENDING)
  items           OrderItem[]
  /// Sum dari (price × qty) semua item — snapshot saat checkout.
  subtotal        Int
  /// Flat fee untuk MVP — nantinya dihitung dari jarak.
  deliveryFee     Int         @default(10000)
  total           Int
  deliveryAddress String
  notes           String?
  /// Timestamp untuk setiap transisi status (untuk timeline UX).
  acceptedAt      DateTime?
  readyAt         DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  payments        Payment[]
  review          Review?

  @@index([customerId])
  @@index([merchantId])
  @@index([driverId])
  @@index([status])
  @@index([createdAt])
}

/// Payment record untuk order. Satu order bisa punya multiple payment attempts
/// (kalau gagal lalu retry), tapi hanya satu yang SUCCESS.
model Payment {
  id              String        @id @default(cuid())
  /// Human-readable: "PAY-XXXXXX"
  code            String        @unique
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Int
  /// Reference dari gateway (Midtrans order_id / Xendit invoice_id).
  /// Untuk mock: "MOCK-{uuid}".
  gatewayReference String?
  /// URL untuk redirect/instruksi pembayaran (Midtrans Snap URL, VA number, dll).
  /// Untuk mock: "https://mock-gateway.rejofood.id/pay/{code}".
  paymentUrl      String?
  /// Snapshot metadata dari gateway response (JSON string).
  gatewayMetadata String?
  /// Timestamp per transisi status.
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  expiresAt       DateTime?    /// Untuk online methods, kapan payment expired.
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([method])
}

/// Snapshot item dari MenuItem saat checkout — tidak berubah meski merchant mengubah menu nanti.
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  /// Snapshot name + price saat checkout (untuk history yang konsisten).
  name        String
  price       Int
  quantity    Int
  subtotal    Int

  @@index([orderId])
}

/// Review dari customer untuk order yang sudah DELIVERED.
/// Satu order = satu review (unique constraint orderId).
/// Rating mempengaruhi Merchant.rating (auto-recompute saat review dibuat).
model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  /// 1-5 stars (integer)
  rating      Int
  /// Optional comment, maks 500 char
  comment     String?
  /// Merchant reply to this review (optional, maks 500 char)
  merchantReply    String?
  merchantReplyAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([customerId])
  @@index([rating])
}

/// Favorite restoran milik customer. Unique constraint (customerId, merchantId).
model Favorite {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([customerId, merchantId])
  @@index([customerId])
  @@index([merchantId])
}

/// Push notification subscription untuk PWA.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Jejak forensik: siapa melakukan apa, kapan, dari mana.
/// Setiap aksi sensitif (login, 2FA, role change, user ban, dll.) wajib dicatat.
/// Tabel ini append-only — tidak ada UPDATE/DELETE dari aplikasi (hanya DBA untuk retensi).
model AuditLog {
  id          String   @id @default(cuid())
  /// ID user yang melakukan aksi. null = aksi anonim (login attempt untuk email tidak dikenal).
  actorId     String?
  /// Email yang dipakai saat aksi (berguna jika actorId null, atau untuk cross-reference).
  actorEmail  String?
  /// Role user saat aksi dilakukan. null = belum terauth (pre-login).
  actorRole   Role?
  /// Kategori aksi: "auth", "admin", "merchant", "driver", "order", dll.
  category    String
  /// Nama aksi spesifik: "login.success", "login.failed", "2fa.setup", "user.ban", dll.
  action      String
  /// ID objek yang dimanipulasi (user ID, order ID, dll). null jika tidak relevan.
  targetId    String?
  /// Tipe objek target: "user", "order", "merchant", dll.
  targetType  String?
  /// Deskripsi human-readable, contoh: "Login berhasil sebagai ADMIN".
  description String
  /// Snapshot metadata tambahan dalam JSON string (IP, user-agent, before/after state, dll).
  metadata    String?
  /// Hasil aksi: "success" | "failure" | "denied".
  outcome     String   @default("success")
  /// IP pelaku.
  ipAddress   String?
  /// User-Agent pelaku (browser/device).
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([category, action])
  @@index([createdAt])
}

/// RejoPay — Dompet digital internal RejoFood.
/// Satu user = satu wallet. Saldo dalam Rupiah (integer, tidak ada floating-point).
/// Driver & Merchant juga punya wallet untuk menerima earning/settlement.
model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Saldo saat ini dalam Rupiah. Bisa negatif hanya untuk kasus luar biasa (default 0).
  balance     Int      @default(0)
  /// True jika admin membekukan dompet (tidak bisa top-up/pay/withdraw sampai di-unfreeze).
  isFrozen    Boolean  @default(false)
  /// PIN 6-digit (bcrypt hash) untuk konfirmasi transaksi sensitif (withdraw, large payment).
  /// null = belum diset, transaksi kecil tidak butuh PIN.
  pinHash     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]

  @@index([userId])
}

/// Riwayat transaksi dompet. Append-only — tidak ada UPDATE/DELETE (kecuali DBA untuk retensi).
/// Setiap baris = satu pergerakan saldo (debit atau kredit).
model WalletTransaction {
  id          String          @id @default(cuid())
  /// Human-readable: "WAL-XXXXXX"
  code        String          @unique
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// Untuk cross-reference (user selain pemilik wallet) — mis. customer bayar ke merchant.
  userId      String
  type        WalletTxType
  status      WalletTxStatus  @default(SUCCESS)
  /// Positif = kredit (saldo naik), negatif = debit (saldo turun).
  amount      Int
  /// Saldo setelah transaksi ini dilakukan (snapshot untuk audit).
  balanceAfter Int
  /// Deskripsi human-readable: "Top-up via QRIS", "Bayar order RF-ABC123", dll.
  description String
  /// ID order terkait (untuk PAYMENT, REFUND, EARNING). null untuk TOPUP/WITHDRAWAL/ADJUSTMENT.
  orderId     String?
  /// Reference dari gateway eksternal (untuk top-up/withdrawal). null untuk transaksi internal.
  gatewayReference String?
  /// Metadata tambahan (JSON string): payment method untuk top-up, bank info untuk withdrawal, dll.
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([orderId])
  @@index([createdAt])
}
