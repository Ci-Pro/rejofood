DATABASE_URL=file:/home/z/my-project/db/custom.db

# RejoFood security flags
# Saat true: akun demo admin (admin@rejofood.id) dapat login.
# Saat false / unset (PRODUCTION): akun demo admin ditolak meski password benar.
REJO_DEMO_MODE=true

# Rate limit login (default aman jika unset)
# REJO_RATE_LIMIT_MAX_ATTEMPTS — max percobaan gagal dalam window (default 5)
# REJO_RATE_LIMIT_WINDOW_MS     — rentang window penghitungan (default 900000 = 15 menit)
# REJO_RATE_LIMIT_LOCKOUT_MS    — durasi lockout setelah max tercapai (default 1800000 = 30 menit)
REJO_RATE_LIMIT_MAX_ATTEMPTS=5
REJO_RATE_LIMIT_WINDOW_MS=900000
REJO_RATE_LIMIT_LOCKOUT_MS=1800000
