# ============================================================================
# RejoFood Environment Variables — SETUP WAJIB
# ============================================================================
# Copy file ini ke .env untuk local dev, atau set di Vercel dashboard → Settings → Environment Variables.
# Lihat DEPLOYMENT.md untuk panduan lengkap.
#
# ⚠️ Untuk Vercel, set SEMUA variabel di bawah ini di:
#   https://vercel.com/<user>/<project>/settings/environment-variables
# Pilih environment: Production + Preview + Development (centang semua).

# ============================================================================
# 1. DATABASE (WAJIB — tanpa ini, app tidak jalan)
# ============================================================================
# Production (Neon Postgres):
#   Dapatkan dari https://console.neon.tech → project → Connection string
#   Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/rejofood?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/rejofood?sslmode=require
#
# Local dev (SQLite — ganti provider di schema.prisma ke "sqlite"):
# DATABASE_URL=file:./db/custom.db

# ============================================================================
# 2. SECURITY FLAGS
# ============================================================================
# Saat true: akun demo admin (admin@rejofood.id) bisa login dengan password demo.
# Saat false (PRODUCTION): akun demo admin ditolak meski password benar.
REJO_DEMO_MODE=false

# ============================================================================
# 3. RATE LIMIT LOGIN
# ============================================================================
REJO_RATE_LIMIT_MAX_ATTEMPTS=5
REJO_RATE_LIMIT_WINDOW_MS=900000
REJO_RATE_LIMIT_LOCKOUT_MS=1800000

# ============================================================================
# 4. REALTIME SERVICE (Socket.IO — OPTIONAL)
# ============================================================================
# Untuk fitur real-time (order status update langsung tanpa refresh).
# Tanpa ini, app fallback ke polling 30s (tetap jalan, hanya agak delayed).
#
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REJO_REALTIME_SECRET=generate-64-char-hex-secret-here
#
# Server-side URL realtime service (Railway):
# Local dev: http://localhost:3001
# Production (Railway): https://your-app.up.railway.app
# Kosongkan jika tidak pakai realtime → app fallback ke polling.
REJO_REALTIME_URL=
#
# Client-side URL socket.io untuk browser:
# NEXT_PUBLIC_REALTIME_URL=wss://your-app.up.railway.app

# ============================================================================
# 5. PAYMENT GATEWAY (Midtrans — untuk produksi)
# ============================================================================
# Mock gateway aktif secara default. Untuk production real payment:
# Daftar: https://midtrans.com → dashboard → Settings → Access Keys
# MIDTRANS_SERVER_KEY=Mid-server-xxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxx
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxxx
# MIDTRANS_MERCHANT_ID=Mxxxxx

# ============================================================================
# 6. ANDROID BUILD (URL backend untuk APK)
# ============================================================================
# URL backend yang akan di-load oleh 3 APK (Customer/Merchant/Driver).
# Set juga di GitHub Secret REJOFOOD_BACKEND_URL untuk CI/CD.
REJOFOOD_BACKEND_URL=https://rejofood.vercel.app

# ============================================================================
# 7. CLOUDINARY (Image Upload — menu, logo, avatar)
# ============================================================================
# Daftar gratis: https://cloudinary.com → dashboard → copy credentials
#
# ⚠️ WAJIB setup Upload Preset (unsigned):
# 1. Cloudinary dashboard → Settings → Upload → Upload presets
# 2. Click "Add upload preset"
# 3. Name: "rejofood" (atau nama lain, sesuaikan dengan CLOUDINARY_UPLOAD_PRESET)
# 4. Signing Mode: UNSIGNED ← WAJIB!
# 5. Folder: "rejofood"
# 6. Save
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=rejofood

# ============================================================================
# 8. DELIVERY FEE (Distance-based — OPTIONAL)
# ============================================================================
# Google Maps API key untuk akurasi jalan. Jika kosong, pakai haversine (jarak lurus × 1.3).
# Dapatkan: https://console.cloud.google.com → enable Distance Matrix API
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
#
# Pricing config (default values):
# REJO_DELIVERY_BASE_FEE=8000     — fee dasar (mencakup 2km pertama)
# REJO_DELIVERY_PER_KM=2000       — tarif per km setelah 2km
# REJO_DELIVERY_MAX_FEE=30000     — cap maksimum
# REJO_DELIVERY_FREE_KM=0         — gratis ongkir dalam X km (0 = tidak ada)

# ============================================================================
# 9. PWA PUSH NOTIFICATIONS (VAPID — OPTIONAL)
# ============================================================================
# Untuk push notifications di browser/Android PWA.
# Generate keys: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:admin@rejofood.id
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key

# ============================================================================
# 10. EMAIL SERVICE (Resend — WAJIB untuk email verification)
# ============================================================================
# Daftar gratis di https://resend.com → dapatkan API key
# Free: 3.000 email/bulan (100/hari) — cukup untuk MVP
# Tanpa ini, email verifikasi hanya di-log ke console (dev mode)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# RESEND_FROM_EMAIL=RejoFood <no-reply@rejofood.id>
#
# URL frontend untuk link verifikasi email:
# NEXT_PUBLIC_APP_URL=https://rejofood.vercel.app

# ============================================================================
# 11. ADMIN IP WHITELIST (OPSIONAL — rekomendasi untuk production)
# ============================================================================
# Daftar IP yang boleh login sebagai ADMIN. Dipisah dengan koma.
# Jika kosong, admin bisa login dari IP manapun (kurang aman).
# Cari IP Anda: https://whatismyipaddress.com
# ADMIN_IP_WHITELIST=203.142.88.10,180.250.100.50
