# ============================================================================
# RejoFood Environment Variables
# ============================================================================
# Copy this file to .env for local dev, atau set ini di Vercel dashboard untuk production.
# Lihat DEPLOYMENT.md untuk panduan lengkap.

# === DATABASE ===
# Local dev (SQLite):
DATABASE_URL=file:./db/custom.db
#
# Production (Neon Postgres — dapat dari Neon dashboard):
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/rejofood?sslmode=require
#
# ⚠️ Saat switch ke Postgres, edit prisma/schema.prisma:
#   provider = "sqlite"  →  provider = "postgresql"
# Lihat DEPLOYMENT.md step 3 untuk detail.

# === SECURITY FLAGS ===
# Saat true: akun demo admin (admin@rejofood.id) dapat login.
# Saat false (PRODUCTION): akun demo admin ditolak meski password benar.
REJO_DEMO_MODE=true

# === RATE LIMIT LOGIN ===
REJO_RATE_LIMIT_MAX_ATTEMPTS=5
REJO_RATE_LIMIT_WINDOW_MS=900000
REJO_RATE_LIMIT_LOCKOUT_MS=1800000

# === REALTIME SERVICE (Socket.IO) ===
# Server-side: secret untuk auth emit endpoint
# Generate baru: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REJO_REALTIME_SECRET=dev-secret-change-in-prod
#
# Server-side: URL realtime service (untuk emit dari Next.js API routes)
# Local dev: http://localhost:3001
# Production (Railway): https://your-app.up.railway.app
# Vercel tanpa Railway: biarkan kosong → app fallback ke polling 30s
REJO_REALTIME_URL=http://localhost:3001
#
# Client-side: URL socket.io untuk browser connect
# Vercel tanpa Railway: biarkan kosong → socket disabled, polling fallback
# Production dengan Railway: wss://your-app.up.railway.app
# NEXT_PUBLIC_REALTIME_URL=

# === PAYMENT GATEWAY (production) ===
# Mock gateway aktif secara default. Untuk production, isi dengan Midtrans credentials:
# MIDTRANS_SERVER_KEY=your-midtrans-server-key
# MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# Lihat src/lib/payment/gateway.ts untuk swap implementation.

# === ANDROID BUILD ===
# URL backend yang akan di-load oleh APK (set di GitHub Secret untuk CI build)
# Deploy backend ke Vercel dulu, lalu set ini = URL Vercel Anda
REJOFOOD_BACKEND_URL=https://your-app.vercel.app

# === CLOUDINARY (Image Upload) ===
# Daftar gratis: https://cloudinary.com → dashboard → copy credentials
#
# SETUP UPLOAD PRESET (PENTING!):
# 1. Cloudinary dashboard → Settings → Upload → Upload presets
# 2. Click "Add upload preset"
# 3. Name: "rejofood" (atau nama lain)
# 4. Signing Mode: UNSIGNED ← WAJIB!
# 5. Folder: "rejofood"
# 6. Save
#
# Set di Vercel env vars:
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=rejofood

# === DELIVERY FEE (Distance-based) ===
# Optional: Google Maps API key untuk akurasi jalan sesungguhnya
# Jika kosong, sistem pakai haversine formula (jarak lurus × 1.3)
# Dapatkan key: https://console.cloud.google.com → enable Distance Matrix API
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
#
# Pricing config (default values shown):
# REJO_DELIVERY_BASE_FEE=8000     — fee dasar (mencakup 2km pertama)
# REJO_DELIVERY_PER_KM=2000       — tarif per km setelah 2km
# REJO_DELIVERY_MAX_FEE=30000     — cap maksimum
# REJO_DELIVERY_FREE_KM=0         — gratis ongkir dalam X km (0 = tidak ada)

# === PWA PUSH NOTIFICATIONS (VAPID) ===
# Generate keys: npx web-push generate-vapid-keys
# Set di Vercel env vars:
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:admin@rejofood.id
