DATABASE_URL=file:./db/custom.db

# RejoFood security flags
# Saat true: akun demo admin (admin@rejofood.id) dapat login.
# Saat false / unset (PRODUCTION): akun demo admin ditolak meski password benar.
REJO_DEMO_MODE=true

# Rate limit login
REJO_RATE_LIMIT_MAX_ATTEMPTS=5
REJO_RATE_LIMIT_WINDOW_MS=900000
REJO_RATE_LIMIT_LOCKOUT_MS=1800000

# Realtime service (socket.io mini-service di port 3001)
# Ganti secret ini di production!
REJO_REALTIME_SECRET=change-this-to-random-secret
REJO_REALTIME_URL=http://localhost:3001

# Payment gateway (production: isi dengan Midtrans/Xendit credentials)
# MIDTRANS_SERVER_KEY=your-midtrans-server-key
# MIDTRANS_CLIENT_KEY=your-midtrans-client-key
# XENDIT_SECRET_KEY=your-xendit-secret-key

# Android build: URL backend yang akan di-load oleh APK
# Deploy Next.js ke Vercel dulu, lalu set URL Vercel di sini
REJOFOOD_BACKEND_URL=https://your-app.vercel.app
